# Copy to .env and fill in. Every setting is optional for paper trading.

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat id(s) allowed to control the bot, comma-separated.
# Don't know yours? Start the bot and send it /start — it replies with your id.
TELEGRAM_CHAT_ID=
# Also message when the bot decides to skip a market (default: only trades)
NOTIFY_SKIPS=false

# --- Strategy ----------------------------------------------------------------
# USD per trade (Polymarket minimum for a market buy is $1)
TRADE_SIZE_USD=1.0
# Buy Up when the Up price is above this, buy Down when it is below the other
TREND_UP_THRESHOLD=0.60
TREND_DOWN_THRESHOLD=0.40
# Never pay more than this per share (at 0.97 a win earns 3c, a loss costs $1)
MAX_ENTRY_PRICE=0.95
# Seconds into the 15-minute market when the bot may enter (780-840 = minute 13)
TRADE_WINDOW_START=780
TRADE_WINDOW_END=840
# How the signal processors gate a trade:
#   none  - trend filter only
#   any   - need at least one fused signal (behaviour of bot.py)
#   agree - fused signal direction must match the trend
SIGNAL_FILTER=any
MIN_FUSION_SCORE=40
MAX_ATTEMPTS_PER_MARKET=3

# --- Risk ----------------------------------------------------------------------
# Stop opening trades for the rest of the UTC day after this realised loss (0 = off)
MAX_DAILY_LOSS_USD=10
# Live mode: worst acceptable price = best ask + SLIPPAGE (capped by MAX_ENTRY_PRICE)
SLIPPAGE=0.02

# --- Paper trading -----------------------------------------------------------------
# Polymarket crypto taker fee: fee = shares x rate x p x (1 - p)
PAPER_FEE_RATE=0.07

# --- Runtime ---------------------------------------------------------------------------
POLL_INTERVAL=5
RESOLVE_INTERVAL=30
DB_PATH=data/polybot.db
LOG_DIR=logs

# --- Polymarket credentials (only for: python -m polybot run --live) ---------------
# Private key of the wallet that signs orders
POLYMARKET_PK=
# 0 = plain EOA wallet, 1 = email/Magic login, 2 = browser wallet (MetaMask etc.)
POLYMARKET_SIGNATURE_TYPE=1
# Your Polymarket deposit (proxy) address, shown on polymarket.com; needed for types 1 and 2
POLYMARKET_FUNDER=
# Optional: derived automatically from the private key when empty
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
